# ===========================================
# LOCAL DEVELOPMENT Environment
# Used by: docker-compose.local.yml
# ===========================================

# --- Docker Compose ---
COMPOSE_PROJECT_NAME=qrc-img-dev

# --- Laravel Application ---
APP_NAME=Laravel
APP_ENV=local
APP_KEY=base64:ChyoI2ZrKyv26B0oey0gjsV/CVeL8f7SwceBpg73w2M=
APP_DEBUG=true
APP_URL=http://localhost:9000

# --- Database (single source of truth) ---
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=eqs_com
DB_USERNAME=eqs_com
DB_PASSWORD=dev_password
MYSQL_ROOT_PASSWORD=dev_root_password

# --- Session & Cache ---
SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Logging ---
LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Mail (log driver for local dev) ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Frontend ---
NUXT_PUBLIC_API_BASE=http://localhost:9000/api/v1