# Production Environment
APP_ENV=production
APP_DEBUG=false

DOMAIN=eshoquranshikhi.org
API_BASE_URL=https://backend.eshoquranshikhi.org/api/v1
FRONTEND_URL=https://eshoquranshikhi.org

# Database Engine Setup
DB_CONNECTION=mysql
# This must match the service key name for MySQL in your docker-compose.yml
DB_HOST=db
DB_PORT=3306
DB_DATABASE=eqs_com_prod
DB_USERNAME=eqs_prod_user
DB_PASSWORD=CHANGE_ME_TO_SOMETHING_VERY_SECURE

MYSQL_ROOT_PASSWORD=CHANGE_ME_TO_ANOTHER_VERY_SECURE_ROOT_PASSWORD

# Ports Configuration
FRONTEND_PORT=3000
BACKEND_PORT=9000
NGINX_PORT=80
NGINX_SSL_PORT=443

# SSL Certificates - Generated by Certbot on your AWS host machine
SSL_CERT_PATH=/etc/letsencrypt/live/eshoquranshikhi.org/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/eshoquranshikhi.org/privkey.pem

COMPOSE_PROJECT_NAME=qrc-img-prod

#Frontend Environment Variables
NUXT_PUBLIC_API_BASE=http://localhost:9000/api/v1