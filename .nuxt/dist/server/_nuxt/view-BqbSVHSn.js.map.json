{"file":"view-BqbSVHSn.js","mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAyQE,UAAM,mBAAmB,oBAAqB;AAG9C,UAAM,aAAa,CAAC,eAAe;AACjC,YAAM,OAAO,IAAI,KAAK,UAAU;AAChC,aAAO,KAAK,mBAAmB,SAAS;AAAA,QACtC,MAAM;AAAA,QACN,OAAO;AAAA,QACP,KAAK;AAAA,MACX,CAAK;AAAA,IACF;AAED,UAAM,iBAAiB,CAAC,eAAe;AACrC,YAAM,OAAO,IAAI,KAAK,UAAU;AAChC,aAAO,KAAK,mBAAmB,SAAS;AAAA,QACtC,MAAM;AAAA,QACN,OAAO;AAAA,QACP,KAAK;AAAA,QACL,MAAM;AAAA,QACN,QAAQ;AAAA,MACd,CAAK;AAAA,IACF;AAED,UAAM,mBAAmB,CAAC,UAAU;AAClC,YAAM,SAAS;AAAA,QACb,GAAG;AAAA,QACH,GAAG;AAAA,QACH,GAAG;AAAA,MACJ;AACD,aAAO,OAAO,KAAK,KAAK,SAAS,KAAK;AAAA,IACvC;AAGD,YAAQ;AAAA,MACN,OAAO;AAAA,IACX,CAAG;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;","names":[],"sources":["../../../../pages/(student)/registration/view.vue"],"sourcesContent":["<!-- pages/registration.vue -->\n<template>\n  <div class=\"min-h-screen bg-emerald-50 py-8 rounded-2xl shadow-xl\">\n    <div class=\"sm:px-6 lg:px-8\">\n      <!-- Header -->\n      <div\n        class=\"bg-white rounded-lg shadow-md mb-6 p-3 sm:p-6 border-t-4 border-emerald-500\"\n      >\n        <div class=\"flex items-center justify-between\">\n          <div>\n            <h1 class=\"text-lg sm:text-3xl font-bold text-emerald-900 mb-2\">\n              Registration Details\n            </h1>\n            <p class=\"text-emerald-600\">View registration form information</p>\n          </div>\n          <div class=\"text-right\">\n            <div class=\"bg-emerald-100 px-2 sm:px-4 sm:py-2 rounded-lg\">\n              <span class=\"text-emerald-800 font-semibold\">\n                Reg No: {{ studentInfoStore.form?.reg_no }}\n              </span>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Registration Form Data -->\n      <div class=\"bg-white rounded-lg shadow-md p-6\">\n        <!-- Basic Information -->\n        <div class=\"mb-8\">\n          <h3\n            class=\"text-xl font-semibold text-emerald-800 mb-4 border-b border-emerald-200 pb-2\"\n          >\n            Basic Information\n          </h3>\n          <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n            <div class=\"space-y-3\">\n              <div>\n                <label class=\"block text-sm font-medium text-gray-600 mb-1\">\n                  Name (English)\n                </label>\n                <div class=\"p-3 bg-gray-50 rounded-lg\">\n                  {{ studentInfoStore.form?.name_en }}\n                </div>\n              </div>\n              <div>\n                <label class=\"block text-sm font-medium text-gray-600 mb-1\">\n                  Name (Bangla)\n                </label>\n                <div class=\"p-3 bg-gray-50 rounded-lg\">\n                  {{ studentInfoStore.form?.name_bn }}\n                </div>\n              </div>\n              <div>\n                <label class=\"block text-sm font-medium text-gray-600 mb-1\">\n                  Date of Birth\n                </label>\n                <div class=\"p-3 bg-gray-50 rounded-lg\">\n                  {{ formatDate(studentInfoStore.form?.dob) }}\n                </div>\n              </div>\n            </div>\n            <div class=\"space-y-3\">\n              <div>\n                <label class=\"block text-sm font-medium text-gray-600 mb-1\">\n                  Phone\n                </label>\n                <div class=\"p-3 bg-gray-50 rounded-lg\">\n                  {{ studentInfoStore.form?.phone }}\n                </div>\n              </div>\n              <div>\n                <label class=\"block text-sm font-medium text-gray-600 mb-1\">\n                  Address\n                </label>\n                <div class=\"p-3 bg-gray-50 rounded-lg\">\n                  {{ studentInfoStore.form?.address }}\n                </div>\n              </div>\n              <div>\n                <label class=\"block text-sm font-medium text-gray-600 mb-1\">\n                  Occupation\n                </label>\n                <div class=\"p-3 bg-gray-50 rounded-lg\">\n                  {{ studentInfoStore.form?.occupation }}\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <!-- Educational Background -->\n        <div class=\"mb-8\">\n          <h3\n            class=\"text-xl font-semibold text-emerald-800 mb-4 border-b border-emerald-200 pb-2\"\n          >\n            Educational Background\n          </h3>\n          <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n            <div class=\"space-y-3\">\n              <div>\n                <label class=\"block text-sm font-medium text-gray-600 mb-1\">\n                  Education Level\n                </label>\n                <div class=\"p-3 bg-gray-50 rounded-lg\">\n                  {{\n                    getEducationText(\n                      studentInfoStore.form?.education_background\n                    )\n                  }}\n                </div>\n              </div>\n              <div>\n                <label class=\"block text-sm font-medium text-gray-600 mb-1\">\n                  School Name\n                </label>\n                <div class=\"p-3 bg-gray-50 rounded-lg\">\n                  {{ studentInfoStore.form?.school_name }}\n                </div>\n              </div>\n              <div>\n                <label class=\"block text-sm font-medium text-gray-600 mb-1\">\n                  College Name\n                </label>\n                <div class=\"p-3 bg-gray-50 rounded-lg\">\n                  {{ studentInfoStore.form?.college_name }}\n                </div>\n              </div>\n            </div>\n            <div class=\"space-y-3\">\n              <div>\n                <label class=\"block text-sm font-medium text-gray-600 mb-1\">\n                  University Name\n                </label>\n                <div class=\"p-3 bg-gray-50 rounded-lg\">\n                  {{ studentInfoStore.form?.university_name }}\n                </div>\n              </div>\n              <div>\n                <label class=\"block text-sm font-medium text-gray-600 mb-1\">\n                  Madrasah Name\n                </label>\n                <div class=\"p-3 bg-gray-50 rounded-lg\">\n                  {{ studentInfoStore.form?.madrasah_name || \"N/A\" }}\n                </div>\n              </div>\n              <div>\n                <label class=\"block text-sm font-medium text-gray-600 mb-1\">\n                  Madrasah Study Details\n                </label>\n                <div class=\"p-3 bg-gray-50 rounded-lg\">\n                  {{ studentInfoStore.form?.madrasah_study_details || \"N/A\" }}\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <!-- Additional Information -->\n        <div class=\"mb-8\">\n          <h3\n            class=\"text-xl font-semibold text-emerald-800 mb-4 border-b border-emerald-200 pb-2\"\n          >\n            Additional Information\n          </h3>\n          <div class=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n            <div>\n              <label class=\"block text-sm font-medium text-gray-600 mb-1\">\n                Season ID\n              </label>\n              <div class=\"p-3 bg-gray-50 rounded-lg\">\n                {{ studentInfoStore.form?.season_id }}\n              </div>\n            </div>\n            <div>\n              <label class=\"block text-sm font-medium text-gray-600 mb-1\">\n                Is Recitation\n              </label>\n              <div class=\"p-3 bg-gray-50 rounded-lg flex items-center\">\n                <div\n                  class=\"w-3 h-3 rounded-full mr-2\"\n                  :class=\"\n                    studentInfoStore.form?.is_recitation\n                      ? 'bg-emerald-500'\n                      : 'bg-gray-400'\n                  \"\n                ></div>\n                {{ studentInfoStore.form?.is_recitation ? \"Yes\" : \"No\" }}\n              </div>\n            </div>\n            <div>\n              <label class=\"block text-sm font-medium text-gray-600 mb-1\">\n                Need Training\n              </label>\n              <div class=\"p-3 bg-gray-50 rounded-lg\">\n                {{ studentInfoStore.form?.need_training || \"N/A\" }}\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <!-- Form Metadata -->\n        <div class=\"bg-emerald-50 rounded-lg p-6\">\n          <h3 class=\"text-lg font-semibold text-emerald-800 mb-4\">\n            Form Information\n          </h3>\n          <div class=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n            <div>\n              <span class=\"block text-sm font-medium text-gray-600\">\n                Form ID\n              </span>\n              <span class=\"text-emerald-800 font-semibold\">\n                {{ studentInfoStore.form?.id }}\n              </span>\n            </div>\n            <div>\n              <span class=\"block text-sm font-medium text-gray-600\">\n                Created At\n              </span>\n              <span class=\"text-emerald-800 font-semibold\">\n                {{ formatDateTime(studentInfoStore.form?.created_at) }}\n              </span>\n            </div>\n            <div>\n              <span class=\"block text-sm font-medium text-gray-600\">\n                Updated At\n              </span>\n              <span class=\"text-emerald-800 font-semibold\">\n                {{ formatDateTime(studentInfoStore.form?.updated_at) }}\n              </span>\n            </div>\n          </div>\n        </div>\n\n        <!-- Action Button -->\n        <div class=\"mt-8 pt-6 border-t border-gray-200\">\n          <NuxtLink\n            to=\"/profile\"\n            class=\"inline-flex items-center px-6 py-3 bg-emerald-600 text-white font-medium rounded-lg hover:bg-emerald-700 transition-colors duration-200\"\n          >\n            <svg\n              class=\"mr-2 w-4 h-4\"\n              fill=\"none\"\n              stroke=\"currentColor\"\n              viewBox=\"0 0 24 24\"\n            >\n              <path\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n                stroke-width=\"2\"\n                d=\"M15 19l-7-7 7-7\"\n              ></path>\n            </svg>\n            Back to Profile\n          </NuxtLink>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script setup>\n  definePageMeta({\n    layout: \"split\",\n  });\n\n  const studentInfoStore = useStudentInfoStore();\n\n  // Helper functions\n  const formatDate = (dateString) => {\n    const date = new Date(dateString);\n    return date.toLocaleDateString(\"en-US\", {\n      year: \"numeric\",\n      month: \"long\",\n      day: \"numeric\",\n    });\n  };\n\n  const formatDateTime = (dateString) => {\n    const date = new Date(dateString);\n    return date.toLocaleDateString(\"en-US\", {\n      year: \"numeric\",\n      month: \"short\",\n      day: \"numeric\",\n      hour: \"2-digit\",\n      minute: \"2-digit\",\n    });\n  };\n\n  const getEducationText = (level) => {\n    const levels = {\n      1: \"General\",\n      2: \"Madrasa\",\n      3: \"(General + Madrasa)\",\n    };\n    return levels[level] || `Level ${level}`;\n  };\n\n  // Set page title\n  useHead({\n    title: \"Registration Details\",\n  });\n\n  onMounted(() => {\n    studentInfoStore.fetchUserProfile();\n  });\n</script>\n"],"version":3}