{"file":"z-B8NujFUt.js","mappings":";;;;;;;AA8HE,UAAM,YAAY,IAAI;AAAA,MACpB;AAAA,QACE,IAAI;AAAA,QACJ,OAAO;AAAA,QACP,QAAQ;AAAA,UACN,EAAE,IAAI,GAAG,OAAO,GAAG,KAAK,EAAE;AAAA,UAC1B,EAAE,IAAI,GAAG,OAAO,GAAG,KAAK,GAAG;AAAA,UAC3B,EAAE,IAAI,GAAG,OAAO,IAAI,KAAK,GAAG;AAAA,UAC5B,EAAE,IAAI,GAAG,OAAO,IAAI,KAAK,GAAG;AAAA,QAAA;AAAA,MAEhC;AAAA,MACA;AAAA,QACE,IAAI;AAAA,QACJ,OAAO;AAAA,QACP,QAAQ;AAAA,UACN,EAAE,IAAI,GAAG,OAAO,GAAG,KAAK,GAAG;AAAA,UAC3B,EAAE,IAAI,GAAG,OAAO,IAAI,KAAK,GAAG;AAAA,UAC5B,EAAE,IAAI,GAAG,OAAO,IAAI,KAAK,KAAK;AAAA,QAAA;AAAA,MAChC;AAAA,IACF,CACD;AAEK,UAAA,gBAAgB,IAAI,EAAE;AAG5B,UAAM,wBAAwB,MAAM;AAClC,YAAM,SAAS,CAAC;AAChB,UAAI,eAAe;AAGnB,YAAM,YAAY,CAAC;AACT,gBAAA,MAAM,QAAQ,CAAC,aAAa;AAC3B,iBAAA,OAAO,QAAQ,CAAC,UAAU;AACjC,oBAAU,KAAK;AAAA,YACb,OAAO,SAAS;AAAA,YAChB,QAAQ;AAAA,UAAA,CACT;AAAA,QAAA,CACF;AAAA,MAAA,CACF;AAGD,eAAS,IAAI,GAAG,IAAI,IAAI,KAAK;AACrB,cAAA,gBAAgB,IAAI,UAAU;AAC9B,cAAA,mBAAmB,UAAU,aAAa;AAEhD,eAAO,KAAK;AAAA,UACV,cAAc;AAAA,UACd,OAAO,iBAAiB;AAAA,UACxB,QAAQ,iBAAiB;AAAA,QAAA,CAC1B;AAAA,MAAA;AAGI,aAAA;AAAA,IACT;AAGA,kBAAc,QAAQ,sBAAsB;AAGtC,UAAA,yBAAyB,CAAC,WAAW;AACnC,YAAA,gBAAgB,CAAC,KAAK,KAAK,KAAK,KAAK,KAAK,KAAK,KAAK,KAAK,KAAK,GAAG;AACvE,aAAO,OACJ,SAAS,EACT,MAAM,EAAE,EACR,IAAI,CAAC,UAAU,cAAc,SAAS,KAAK,CAAC,CAAC,EAC7C,KAAK,EAAE;AAAA,IACZ;AAEM,UAAA,yBAAyB,CAAC,WAAW;AACnC,YAAA,gBAAgB,CAAC,KAAK,KAAK,KAAK,KAAK,KAAK,KAAK,KAAK,KAAK,KAAK,GAAG;AACvE,aAAO,OACJ,SAAS,EACT,MAAM,EAAE,EACR,IAAI,CAAC,UAAU,cAAc,SAAS,KAAK,CAAC,CAAC,EAC7C,KAAK,EAAE;AAAA,IACZ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;","names":[],"sources":["../../../../pages/z.vue"],"sourcesContent":["<template>\n  <div>\n    <div class=\"min-h-screen bg-gray-50 lottery-page\">\n      <!-- Control Panel (Hidden in print) -->\n      <div class=\"print:hidden bg-white shadow-sm border-b p-4 mb-6\">\n        <div class=\"max-w-7xl mx-auto\">\n          <h1 class=\"text-2xl font-bold text-emerald-800 mb-4\">\n            Quran Competition Lottery Chunks Generator\n          </h1>\n          <div class=\"text-gray-600 mb-4\">\n            Total Chunks: {{ lotteryChunks.length }}\n          </div>\n          <button\n            @click=\"printChunks\"\n            class=\"bg-emerald-600 hover:bg-emerald-700 text-white px-6 py-2 rounded-lg font-medium transition-colors\"\n          >\n            🖨️ Print Lottery Chunks\n          </button>\n        </div>\n      </div>\n\n      <!-- Lottery Chunks Grid -->\n      <div class=\"max-w-7xl mx-auto p-4\">\n        <div class=\"flex flex-wrap gap-2\">\n          <div\n            v-for=\"chunk in lotteryChunks\"\n            :key=\"chunk.serialNumber\"\n            class=\"lottery-chunk bg-white border-2 border-dashed border-emerald-300 rounded p-1 min-w-[300px]\"\n          >\n            <!-- Competition Title -->\n            <div class=\"text-center mb-1\">\n              <div\n                class=\"text-xs font-bold text-emerald-800 print:text-xs leading-tight\"\n              >\n                বিশুদ্ধ কুরআন পাঠ প্রতিযোগিতা\n              </div>\n              <div class=\"text-xs text-emerald-600 print:text-xs\">\n                ১৪৪৭ হিজরি\n              </div>\n            </div>\n\n            <!-- Serial Number -->\n            <div class=\"text-center mb-2\">\n              <div\n                class=\"bg-emerald-100 border border-emerald-300 rounded-full w-8 h-8 flex items-center justify-center mx-auto print:w-6 print:h-6\"\n              >\n                <span class=\"text-sm font-bold text-emerald-800 print:text-xs\">\n                  {{ chunk.serialNumber }}\n                </span>\n              </div>\n            </div>\n\n            <!-- Surah Name (Full) -->\n            <div class=\"text-center mb-2\">\n              <div\n                class=\"text-xs font-bold text-emerald-900 print:text-xs leading-tight\"\n              >\n                {{ chunk.surah }}\n              </div>\n            </div>\n\n            <!-- Verses -->\n            <div\n              class=\"text-center flex justify-center items-center gap-2 font-bold text-sm text-emerald-800\"\n            >\n              <div class=\"\">\n                <template v-if=\"chunk.verses.end !== null\">\n                  {{ convertToBanglaNumbers(chunk.verses.start) }}-{{\n                    convertToBanglaNumbers(chunk.verses.end)\n                  }}\n                </template>\n                <template v-else>\n                  {{ convertToBanglaNumbers(chunk.verses.start) }}\n                </template>\n              </div>\n              <span>|</span>\n              <div class=\"\">\n                <template v-if=\"chunk.verses.end !== null\">\n                  {{ chunk.verses.start }}-{{ chunk.verses.end }}\n                </template>\n                <template v-else>\n                  {{ chunk.verses.start }}\n                </template>\n              </div>\n              <span>|</span>\n              <div class=\"\">\n                <template v-if=\"chunk.verses.end !== null\">\n                  {{ convertToArabicNumbers(chunk.verses.start) }}-{{\n                    convertToArabicNumbers(chunk.verses.end)\n                  }}\n                </template>\n                <template v-else>\n                  {{ convertToArabicNumbers(chunk.verses.start) }}\n                </template>\n              </div>\n            </div>\n\n            <!-- Note for all chunks -->\n            <div class=\"text-center mt-2\">\n              <div class=\"text-xs text-red-600 font-medium print:text-xs\">\n                <template v-if=\"chunk.verses.end !== null\">\n                  আপনাকে\n                  {{ convertToBanglaNumbers(chunk.verses.start) }}-{{\n                    convertToBanglaNumbers(chunk.verses.end)\n                  }}\n                  নম্বর আয়াতসমূহ পড়তে হবে\n                </template>\n                <template v-else>\n                  আপনাকে শুধুমাত্র এই\n                  {{ convertToBanglaNumbers(chunk.verses.start) }} নম্বর আয়াতটি\n                  পড়তে হবে\n                </template>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script setup>\n  definePageMeta({\n    layout: false,\n  });\n\n  const questions = ref([\n    {\n      id: 1,\n      surah: \"আল-মুলক | Al-Mulk | سورة الملك\",\n      verses: [\n        { id: 1, start: 1, end: 7 },\n        { id: 2, start: 8, end: 16 },\n        { id: 3, start: 17, end: 24 },\n        { id: 4, start: 25, end: 30 },\n      ],\n    },\n    {\n      id: 2,\n      surah: \"আল-মুযযাম্মিল | Al-Muzzammil | سورة المزمل\",\n      verses: [\n        { id: 1, start: 1, end: 11 },\n        { id: 2, start: 12, end: 19 },\n        { id: 3, start: 20, end: null },\n      ],\n    },\n  ]);\n\n  const lotteryChunks = ref([]);\n\n  // Generate lottery chunks\n  const generateLotteryChunks = () => {\n    const chunks = [];\n    let serialNumber = 1;\n\n    // Create a circular pattern for questions\n    const allVerses = [];\n    questions.value.forEach((question) => {\n      question.verses.forEach((verse) => {\n        allVerses.push({\n          surah: question.surah,\n          verses: verse,\n        });\n      });\n    });\n\n    // Generate 29 chunks (number of students)\n    for (let i = 0; i < 29; i++) {\n      const questionIndex = i % allVerses.length;\n      const selectedQuestion = allVerses[questionIndex];\n\n      chunks.push({\n        serialNumber: serialNumber++,\n        surah: selectedQuestion.surah,\n        verses: selectedQuestion.verses,\n      });\n    }\n\n    return chunks;\n  };\n\n  // Initialize chunks\n  lotteryChunks.value = generateLotteryChunks();\n\n  // Convert numbers to different number systems\n  const convertToArabicNumbers = (number) => {\n    const arabicNumbers = [\"٠\", \"١\", \"٢\", \"٣\", \"٤\", \"٥\", \"٦\", \"٧\", \"٨\", \"٩\"];\n    return number\n      .toString()\n      .split(\"\")\n      .map((digit) => arabicNumbers[parseInt(digit)])\n      .join(\"\");\n  };\n\n  const convertToBanglaNumbers = (number) => {\n    const banglaNumbers = [\"০\", \"১\", \"২\", \"৩\", \"৪\", \"৫\", \"৬\", \"৭\", \"৮\", \"৯\"];\n    return number\n      .toString()\n      .split(\"\")\n      .map((digit) => banglaNumbers[parseInt(digit)])\n      .join(\"\");\n  };\n\n  const printChunks = () => {\n    window.print();\n  };\n</script>\n\n<style>\n  @media print {\n    @page {\n      size: A4 landscape;\n      /* margin: 10mm; */\n    }\n\n    body {\n      margin: 0;\n      padding: 0;\n    }\n\n    .lottery-page,\n    .lottery-page *,\n    .lottery-chunk,\n    .lottery-chunk * {\n      visibility: visible;\n    }\n\n    .lottery-chunk {\n      break-inside: avoid;\n      page-break-inside: avoid;\n    }\n\n    /* Ensure colors print correctly */\n    * {\n      -webkit-print-color-adjust: exact;\n      print-color-adjust: exact;\n    }\n  }\n\n  .lottery-chunk {\n    min-height: 100px;\n  }\n\n  @media print {\n    .lottery-chunk {\n      min-height: 80px;\n    }\n  }\n</style>\n"],"version":3}