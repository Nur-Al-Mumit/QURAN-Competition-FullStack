# ===========================================
# PRODUCTION Environment
# Used by: docker-compose.yml (AWS CI/CD)
# ===========================================

# --- Docker Compose ---
COMPOSE_PROJECT_NAME=qrc-img-prod-x

# --- Laravel Application ---
APP_NAME=Laravel
APP_ENV=production
APP_KEY=base64:ChyoI2ZrKyv26B0oey0gjsV/CVeL8f7SwceBpg73w2M=
APP_DEBUG=false
APP_URL=https://backend.eshoquranshikhi.org

# --- Database (single source of truth) ---
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=eqs_com_prod
DB_USERNAME=eqs_prod_user
DB_PASSWORD=CHANGE_ME_TO_SOMETHING_VERY_SECURE
MYSQL_ROOT_PASSWORD=CHANGE_ME_TO_ANOTHER_VERY_SECURE_ROOT_PASSWORD

# --- Session & Cache ---
SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Logging ---
LOG_CHANNEL=stack
LOG_LEVEL=error

# --- Mail ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- SSL (Certbot on AWS host) ---
SSL_CERT_PATH=/etc/letsencrypt/live/eshoquranshikhi.org/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/eshoquranshikhi.org/privkey.pem

# --- Frontend ---
NUXT_PUBLIC_API_BASE=https://backend.eshoquranshikhi.org/api/v1
